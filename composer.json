{
    "name": "omnireach/ga4",
    "type": "library",
    "description": "Omnireach's Google Analytics 4, under any PHP host: visitors, sessions, pageviews, bounce rate and session length of a property, by landing page, page, source, country, device or day, through the Google Analytics Data API (runReport; a service account's key or an access token).",
    "keywords": [
        "google",
        "google-analytics",
        "ga4",
        "analytics",
        "audience",
        "data-api",
        "framework-agnostic",
        "omnireach"
    ],
    "homepage": "https://github.com/glitchr-studio/omnireach-ga4",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "omniscient/omnireach": "^1.0@dev",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Omnireach\\Ga4\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnireach\\Ga4\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
